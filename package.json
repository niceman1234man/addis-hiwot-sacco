    "start": "node backend/src/server.js",
    "admin:bootstrap": "node backend/src/scripts/bootstrapAdmin.js"
  },
  "dependencies": {
    "@clerk/backend": "^3.23.2",
    "@clerk/express": "^2.1.78",
    "@clerk/react": "^6.17.8",
    "@clerk/shared": "^4.40.0",
    "@clerk/themes": "^2.4.57",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "http-proxy-middleware": "^4.2.0",
    "lucide-react": "^1.57.0",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "wouter": "^3.13.0"
  }
